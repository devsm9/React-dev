import React, { useState } from 'react';
import { Upload, Button, Input, Checkbox } from 'antd';
import { UploadOutlined } from '@ant-design/icons';
import Papa from 'papaparse';

const UploadCSV = () => {
  const [fileContent, setFileContent] = useState([]);
  const [inputValue, setInputValue] = useState('');
  const [fileName, setFileName] = useState('');
  const [headers, setHeaders] = useState([]);
  const [selectedColumns, setSelectedColumns] = useState([]);
  const [filteredData, setFilteredData] = useState([]);

  const handleFileUpload = (file) => {
    setFileName(file.name);
    Papa.parse(file, {
      complete: (results) => {
        const [headers, ...data] = results.data;
        setHeaders(headers);
        setFileContent(data);
      },
      header: false
    });
    return false; // Prevent automatic upload
  };

  const handleInputChange = (e) => {
    setInputValue(e.target.value);
    const filtered = fileContent.reduce((acc, row) => {
      const matchedCells = row.reduce((matches, cell) => {
        const cellStr = cell.toString();
        const index = cellStr.indexOf(e.target.value);
        if (index !== -1) {
          const prefix = cellStr.substring(0, index);
          const suffix = cellStr.substring(index + e.target.value.length);
          matches.push({ prefix, value: e.target.value, suffix });
        }
        return matches;
      }, []);
      if (matchedCells.length > 0) {
        acc.push({ row, matches: matchedCells });
      }
      return acc;
    }, []);
    setFilteredData(filtered);
  };

  const handleColumnSelection = (checkedValues) => {
    setSelectedColumns(checkedValues);
  };

  return (
    <div>
      <Upload
        accept=".csv"
        beforeUpload={handleFileUpload}
        showUploadList={false}
      >
        <Button icon={<UploadOutlined />}>Upload CSV</Button>
      </Upload>
      {fileContent.length > 0 && (
        <>
          <div>Uploaded File: {fileName}</div>
          <Input
            placeholder="Enter string to search"
            value={inputValue}
            onChange={handleInputChange}
            style={{ margin: '20px 0' }}
          />
          <div>
            <strong>Select Columns:</strong>
            <Checkbox.Group
              options={headers}
              onChange={handleColumnSelection}
              style={{ margin: '20px 0' }}
            />
          </div>
        </>
      )}
      {filteredData.length > 0 && (
        <div>
          <h3>Filtered Data</h3>
          <pre>{JSON.stringify(filteredData, null, 2)}</pre>
        </div>
      )}
    </div>
  );
};

export default UploadCSV;


